pkgname = linux-mooly
	pkgdesc = The Linux BORE + Cachy Sauce + AutoFDO/Propeller Kernel by CachyOS - MooLy variant. kernel and modules
	depends = coreutils
	depends = kmod
	depends = initramfs
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = modprobed-db: Keeps track of EVERY kernel module that has ever been probed - useful for those of us who make localmodconfig
	optdepends = scx-scheds: to use sched-ext schedulers
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = KSMBD-MODULE
	provides = V4L2LOOPBACK-MODULE
	provides = NTSYNC-MODULE
	provides = VHBA-MODULE
	provides = ADIOS-MODULE
	provides = linux-cachyos-lto=7.2.11-1
	replaces = linux-cachyos-lto

pkgname = linux-mooly-headers
	pkgdesc = Headers and scripts for building modules for the Linux BORE + Cachy Sauce + AutoFDO/Propeller Kernel by CachyOS - MooLy variant. kernel
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	depends = linux-mooly
	depends = clang
	depends = llvm
	depends = lld
	provides = LINUX-HEADERS
	provides = linux-cachyos-lto-headers=7.2.11-1
	replaces = linux-cachyos-lto-headers

pkgname = linux-mooly-zfs
	pkgdesc = zfs module for the Linux BORE + Cachy Sauce + AutoFDO/Propeller Kernel by CachyOS - MooLy variant. kernel
	license = CDDL
	depends = pahole
	depends = linux-mooly=7.2.11-1
	provides = ZFS-MODULE

pkgname = linux-mooly-nvidia-open
	pkgdesc = nvidia open modules of 615.71.09 driver for the linux-mooly kernel
	license = MIT AND GPL-2.0-only
	depends = linux-mooly=7.2.11-1
	depends = nvidia-utils=615.71.09
	depends = libglvnd
	provides = NVIDIA-MODULE
	conflicts = linux-mooly-nvidia

pkgname = linux-mooly-ryzen-smu
	pkgdesc = ryzen_smu module for the linux-mooly kernel (AMD OC/OV support)
	license = GPL-2.0-only
	depends = linux-mooly=7.2.11-1
	provides = RYZEN-SMU-MODULE
